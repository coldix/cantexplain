---
import { SITE, FAMILY, MAINTAINER } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="eyebrow">Can’t Explain</p>
        <p class="muted">
          {SITE.tagline} A receipt-first hall of ridiculous claims. Published by
          {SITE.publisher}. Not a party, not a campaign, not a news desk.
        </p>
      </div>

      <div>
        <p class="eyebrow">The hall</p>
        <ul>
          <li><a href="/hall">All entries</a></li>
          <li><a href="/method">How a receipt works</a></li>
          <li><a href="/about">About &amp; independence</a></li>
          <li><a href={SITE.repo}>Source repository</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">Elsewhere</p>
        <ul>
          {
            FAMILY.map((f) => (
              <li>
                <a href={f.href} rel="noopener">{f.name}</a>
              </li>
            ))
          }
          <li><a href={SITE.publisherUrl} rel="noopener">Oze</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">Legal</p>
        <ul>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li>
            <a href={SITE.issues} rel="noopener">Suggest a correction</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-meta muted">
        <span>© {year} {SITE.publisher}. {MAINTAINER.name}.</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>Code MIT-licensed. Evidence files live in git.</span>
      </p>

      <a class="design-credit" href={SITE.publisherUrl} rel="noopener">
        <span class="design-credit-text">Website design</span>
        <img
          class="design-credit-logo"
          src="/images/oze-logo.png"
          alt="Oze"
          width="88"
          height="41"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--surface-2);
    padding-block: clamp(2rem, 5vw, 3.25rem) 2rem;
    margin-top: 4rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.75rem 2.5rem;
  }
  .cols p.muted {
    max-width: 32rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
  }
  .footer-bottom {
    margin: 2.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .footer-meta {
    flex: 1 1 18rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    max-width: 52rem;
  }
  .meta-sep {
    margin: 0 0.4rem;
    opacity: 0.45;
  }
  .design-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink-3);
    font-size: 0.8rem;
    font-weight: 520;
    flex: none;
  }
  .design-credit:hover {
    color: var(--ink);
  }
  .design-credit-logo {
    width: 4.4rem;
    height: auto;
    opacity: 0.92;
  }
</style>
