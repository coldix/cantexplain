---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LinkWindow from "../components/LinkWindow.astro";
import { SITE, FAMILY } from "../lib/site";

const {
  title,
  description = SITE.tagline,
  schema = null,
  breadcrumbs = null,
  noindex = false,
  minimal = false,
  ogType = "website",
  publishedTime = null,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", SITE.url).href;
const ogImage = new URL("/images/og-image.svg", SITE.url).href;
const ogAlt = `${SITE.name} — ${SITE.tagline}`;

const graph = [
  {
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    alternateName: ["Can't Explain", "cantexplain.au"],
    url: SITE.url,
    description: SITE.descriptionLong,
    email: SITE.email,
    areaServed: { "@type": "Country", name: "Australia" },
    knowsAbout: [
      "Australian politics",
      "political claims",
      "evidence and sources",
      "Pauline Hanson",
      "One Nation",
    ],
    sameAs: [SITE.repo, ...FAMILY.map((f) => f.href)],
    publishingPrinciples: `${SITE.url}/method`,
    ethicsPolicy: `${SITE.url}/about`,
    parentOrganization: {
      "@type": "Organization",
      name: SITE.publisher,
      url: SITE.publisherUrl,
    },
    founder: { "@id": `${SITE.url}/#author` },
  },
  {
    "@type": "Person",
    "@id": `${SITE.url}/#author`,
    name: "Colin Dixon",
    url: `${SITE.url}/about`,
    jobTitle: "Author",
    nationality: { "@type": "Country", name: "Australia" },
    sameAs: ["https://x.com/colindixon", "https://www.linkedin.com/in/colindixon/"],
    worksFor: { "@id": `${SITE.url}/#organization` },
  },
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    alternateName: SITE.short,
    description: SITE.descriptionLong,
    inLanguage: "en-AU",
    isAccessibleForFree: true,
    publisher: { "@id": `${SITE.url}/#organization` },
    author: { "@id": `${SITE.url}/#author` },
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/hall?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": `${SITE.url}/#organization` },
    inLanguage: "en-AU",
    isAccessibleForFree: true,
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImage,
    },
  },
];

if (breadcrumbs?.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: new URL(b.href, SITE.url).href,
    })),
  });
}

if (schema) graph.push(...(Array.isArray(schema) ? schema : [schema]));

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("ce-theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Colin Dixon" />
    <meta name="publisher" content={SITE.publisher} />
    <meta name="geo.region" content="AU" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-AU" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }
    <meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large"} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:alt" content={ogAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && <meta property="article:author" content="Colin Dixon" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:creator" content="@colindixon" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Guide for AI systems (summary)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Guide for AI systems (full)" />
    <link rel="author" href={`${SITE.url}/about`} />
    {
      canonical === `${SITE.url}/` && SITE.googleSiteVerification ? (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      ) : null
    }
    <meta name="theme-color" content="#9a3412" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      SITE.gaMeasurementId ? (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${SITE.gaMeasurementId}');`}
          />
        </>
      ) : null
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header compact={minimal} />
    <main id="main">
      <slot />
    </main>
    {minimal ? null : <Footer />}
    <LinkWindow />
  </body>
</html>
