---
import Base from "../layouts/Base.astro";
---

<Base title="Not in the hall" description="That page is not here." noindex={true}>
  <div class="wrap wrap-narrow section">
    <p class="eyebrow">404</p>
    <h1>Can’t explain this URL</h1>
    <p class="lede">Nothing is filed at this path. It may have been a draft, or a typo.</p>
    <div class="btn-row">
      <a class="btn" href="/hall">The hall</a>
      <a class="btn btn-ghost" href="/">Home</a>
    </div>
  </div>
</Base>
