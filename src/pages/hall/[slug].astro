---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ShareBar from "../../components/ShareBar.astro";
import { CLAIM_TYPE_LABEL, LOUDNESS_HINT, formatDate, formatDateLong, SITE, loudnessOf } from "../../lib/site";
import { evidenceHref, liveEntries, type Entry } from "../../lib/entries";

export async function getStaticPaths() {
  const entries = await liveEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const evidenceUrl = evidenceHref(data.evidence.path);
const sourceDate = formatDateLong(data.source.date);
const published = formatDate(data.published);
const loud = loudnessOf(data.loudness);
const pageUrl = new URL(`/hall/${entry.id}`, SITE.url).href;
const shareText = `“${data.claim}” — ${SITE.name}`;

const schema = {
  "@type": "Article",
  headline: data.title,
  description: data.caption,
  datePublished: data.published.toISOString(),
  author: { "@id": `${SITE.url}/#author` },
  publisher: { "@id": `${SITE.url}/#organization` },
  mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
  about: [
    { "@type": "Person", name: data.person },
    { "@type": "Thing", name: data.claimType },
  ],
  citation: data.source.url,
  keywords: data.tags.join(", "),
  inLanguage: "en-AU",
  isAccessibleForFree: true,
};
---

<Base
  title={data.title}
  description={data.caption}
  schema={schema}
  ogType="article"
  publishedTime={data.published.toISOString()}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "The hall", href: "/hall" },
    { name: data.title, href: `/hall/${entry.id}` },
  ]}
>
  <article class="entry wrap section">
    <header class="entry-head">
      <p class="eyebrow">
        <a href="/hall" data-no-popup>The hall</a>
        <span aria-hidden="true"> / </span>
        {CLAIM_TYPE_LABEL[data.claimType]}
      </p>
      <div class="pills">
        <span class="pill pill-featured" title={LOUDNESS_HINT[loud]}>Loudness {loud}</span>
        {data.example && <span class="pill pill-example">Format example</span>}
      </div>
      <h1>{data.title}</h1>
      <p class="lede caption">{data.caption}</p>
    </header>

    {
      data.example && (
        <p class="notice">
          <strong>Scaffold example.</strong> This card demonstrates the template. It is not
          a live hall entry and will be replaced before launch.
        </p>
      )
    }

    <blockquote class="claim">
      <p>{data.claim}</p>
      {
        data.source.quote && data.source.quote !== data.claim && (
          <footer class="muted">Quoted in source: “{data.source.quote}”</footer>
        )
      }
    </blockquote>

    <div class="entry-grid">
      <div class="entry-main">
        {
          data.media && (
            <figure class="media">
              {data.media.type === "video" ? (
                <video src={data.media.src} controls playsinline></video>
              ) : (
                <img src={data.media.src} alt={data.media.alt || ""} />
              )}
              {data.media.caption && <figcaption class="muted">{data.media.caption}</figcaption>}
            </figure>
          )
        }
        <div class="prose body">
          <Content />
        </div>
        <ul class="tags">
          {
            data.tags.map((tag) => (
              <li>
                <a class="pill pill-type" href={`/hall?q=${encodeURIComponent(tag)}`} data-no-popup>
                  {tag}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="entry-rail" aria-label="Receipt and share">
        <div class="receipt card">
          <p class="eyebrow">Receipt</p>
          <dl>
            <div>
              <dt>About</dt>
              <dd>{data.person}</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>
                <a href={data.source.url}>{data.source.title || data.source.publisher}</a>
                <span class="muted">
                  {" "}
                  — {data.source.publisher}, <time datetime={data.source.date}>{sourceDate}</time>
                </span>
              </dd>
            </div>
            <div>
              <dt>Evidence</dt>
              <dd>
                <a href={evidenceUrl}>{data.evidence.path}</a>
                <span class="muted"> ({data.evidence.kind})</span>
              </dd>
            </div>
            {
              data.evidence.archiveUrl && (
                <div>
                  <dt>Archive</dt>
                  <dd>
                    <a href={data.evidence.archiveUrl}>Backup copy</a>
                  </dd>
                </div>
              )
            }
            <div>
              <dt>In the hall</dt>
              <dd>
                <time datetime={data.published.toISOString()}>{published}</time>
                <span class="muted"> — timestamp is the git commit that added the file.</span>
              </dd>
            </div>
          </dl>
        </div>
        <ShareBar url={pageUrl} text={shareText} />
      </aside>
    </div>
  </article>
</Base>

<style>
  .entry {
    padding-top: clamp(1.75rem, 4vw, 3rem);
  }
  .entry-head {
    max-width: 46rem;
  }
  .pills {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .caption {
    font-family: var(--font-serif);
  }
  .claim {
    margin: 1.5rem 0 1.75rem;
    padding: 0.85rem 0 0.85rem 1.15rem;
    border-left: 4px solid var(--stamp);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.65rem);
    line-height: 1.35;
    max-width: 46rem;
  }
  .claim p {
    margin: 0;
  }
  .claim footer {
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
  }
  .entry-grid {
    display: grid;
    gap: 1.5rem 2rem;
  }
  @media (min-width: 60rem) {
    .entry-grid {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
    .entry-rail {
      position: sticky;
      top: 5rem;
    }
  }
  .receipt {
    margin: 0 0 1rem;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }
  dt {
    font-size: 0.72rem;
    font-weight: 660;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.15rem;
  }
  dd {
    margin: 0;
  }
  .body {
    margin: 0;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags a {
    text-decoration: none;
  }
  .media {
    margin: 0 0 1.5rem;
  }
  .media img,
  .media video {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
  }
</style>
