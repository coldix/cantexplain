---
import Base from "../../layouts/Base.astro";
import EntryCard from "../../components/EntryCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import { CLAIM_TYPE_LABEL } from "../../lib/site";
import { liveEntries, uniqueSorted } from "../../lib/entries";

const entries = await liveEntries();
const people = uniqueSorted(entries.map((e) => e.data.person));
const years = uniqueSorted(entries.map((e) => String(e.data.year))).reverse();
const typeValues = uniqueSorted(entries.map((e) => e.data.claimType));
const types = typeValues.map((value) => ({
  value,
  label: CLAIM_TYPE_LABEL[value] ?? value,
}));
---

<Base
  title="The hall"
  description="Every published claim in the Can’t Explain hall, with sources and receipts. Filter by person, type, or year."
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "The hall", href: "/hall" },
  ]}
>
  <div class="wrap section">
    <p class="eyebrow">The hall</p>
    <h1>Ridiculous claims, with receipts</h1>
    <p class="lede">
      Search the hall, or filter by person, room, year, and loudness. Rooms are health,
      climate, money, and speech. The number is how far the slogan travelled, not a
      verdict. Every live card has an original source and a file in git.
    </p>

    <FilterBar people={people} types={types} years={years} count={entries.length} />

    <div class="grid" id="hall-grid">
      {entries.map((entry) => <EntryCard entry={entry} />)}
    </div>
    <p class="notice" id="filter-empty" hidden>
      Nothing in the hall matches that filter. Clear the search or pick another person.
    </p>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 70rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
