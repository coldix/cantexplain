---
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import ShareBar from "../../components/ShareBar.astro";
import { SITE } from "../../lib/site";
import { listRepoMarkdown, readRepoMarkdown, titleFromMarkdown } from "../../lib/markdown-files";

export async function getStaticPaths() {
  const files = await listRepoMarkdown();
  return files.map((f) => ({
    params: { path: f.rel },
  }));
}

const rel = Astro.params.path;
if (!rel) return Astro.redirect("/404");
const file = await readRepoMarkdown(rel);
if (!file) return Astro.redirect("/404");

const title = titleFromMarkdown(file.rel, file.body);
const lookable = new Set((await listRepoMarkdown()).map((f) => f.rel));
const dir = file.rel.includes("/") ? file.rel.slice(0, file.rel.lastIndexOf("/") + 1) : "";
const esc = (v: string) => v.replace(/&/g, "&amp;").replace(/"/g, "&quot;");
// Repo docs are written for GitHub. Relative links to files the site does not
// render (LICENSE, scripts) go to the GitHub blob; dev-server links are unlinked.
const html = (marked.parse(file.body, { async: false, gfm: true }) as string).replace(
  /<a href="([^"]*)"([^>]*)>([\s\S]*?)<\/a>/g,
  (whole, href: string, rest: string, text: string) => {
    if (/^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?(\/|$)/i.test(href)) return `<code>${text}</code>`;
    if (/^([a-z][a-z0-9+.-]*:|\/|#)/i.test(href)) return whole;
    const [pathPart, hash = ""] = href.split("#");
    const target = new URL(pathPart, `https://x/${dir}`).pathname.slice(1);
    if (lookable.has(target)) return whole;
    if (target.startsWith("evidence/")) return `<a href="${esc(`/${target}`)}"${rest}>${text}</a>`;
    const out = `${SITE.repo}/blob/main/${target}${hash ? `#${hash}` : ""}`;
    return `<a href="${esc(out)}"${rest}>${text}</a>`;
  },
);
const lookUrl = new URL(`/look/${file.rel}`, SITE.url).href;
const rawUrl = file.rel.startsWith("evidence/") ? `/${file.rel}` : `${SITE.repo}/blob/main/${file.rel}`;
const shareText = `${title} — ${SITE.name}`;
---

<Base
  title={title}
  description={`Receipt file from the Can’t Explain repository: ${file.rel}`}
  minimal={true}
>
  <article class="look wrap section">
    <header class="look-head">
      <p class="eyebrow">Repository file</p>
      <h1>{title}</h1>
      <p class="mono path muted">{file.rel}</p>
      <p class="look-back muted">
        From <a href="/" data-no-popup>{SITE.name}</a>
        <span aria-hidden="true"> · </span>
        <a href={rawUrl}>{file.rel.startsWith("evidence/") ? "Raw capture" : "On GitHub"}</a>
      </p>
    </header>

    <ShareBar url={lookUrl} text={shareText} copyExtra={file.body} />

    <div class="look-paper card prose" set:html={html} />
  </article>
</Base>

<style>
  .look {
    max-width: 46rem;
    padding-top: 2rem;
  }
  .look-head h1 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .path {
    margin: 0.35rem 0 0.75rem;
    word-break: break-all;
  }
  .look-back {
    margin: 0 0 1.1rem;
  }
  .look-paper {
    margin-top: 1.25rem;
  }
  .look-paper :global(pre) {
    overflow-x: auto;
    padding: 0.85rem 1rem;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
  }
  .look-paper :global(blockquote) {
    margin: 1rem 0;
    padding: 0.2rem 0 0.2rem 0.9rem;
    border-left: 3px solid var(--stamp);
    font-family: var(--font-serif);
  }
  .look-paper :global(hr) {
    margin: 1.5rem 0;
  }
</style>
